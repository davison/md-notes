{
  "name": "mdn-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.inject.config.ts && node scripts/stamp-manifest.mjs",
    "zip": "node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node --test e2e/*.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "@types/turndown": "5.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
