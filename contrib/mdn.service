# systemd user unit for the mdn daemon.
#
#   install -Dm644 contrib/mdn.service ~/.config/systemd/user/mdn.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now mdn
#
# The daemon reads ~/.config/mdn/config.yml. Put the mdn binary somewhere on
# PATH such as ~/.local/bin, or change ExecStart to its absolute path.

[Unit]
Description=mdn markdown notes daemon

[Service]
ExecStart=%h/.local/bin/mdn serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
