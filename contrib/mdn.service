# systemd user unit for the mdn daemon.
#
# The package installs this file for you, at
# /usr/lib/systemd/user/mdn.service, and so does `make install` — which is a
# copy and nothing else, so build first, as yourself:
#
#   make build           # as you; install never builds (davison/md-notes#164)
#   sudo make install    # /usr/bin/mdn and /usr/lib/systemd/user/mdn.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now mdn
#
# The last two lines are yours to run and not root's: under sudo,
# `systemctl --user` is root's session rather than yours, so `make install`
# prints those two lines instead of running them.
#
# Either way the daemon runs from /usr/bin/mdn and reads
# ~/.config/mdn/config.yml.
#
# Installed somewhere else — `make install PREFIX=$HOME/.local`, or any other
# prefix — this file goes under that prefix too, at
# $PREFIX/lib/systemd/user/mdn.service. systemd reads that only for a prefix
# whose lib/systemd/user it already searches (/usr and /usr/local do;
# ~/.local does not — `systemd-analyze --user unit-paths` lists yours), so for
# a per-user prefix put the unit where it is read, by hand:
#
#   install -Dm644 contrib/mdn.service ~/.config/systemd/user/mdn.service
#
# Either way, do not edit this file for a different path: add a drop-in, which
# survives the next upgrade of the package or the next `git pull`.
#
#   mkdir -p ~/.config/systemd/user/mdn.service.d
#   cat > ~/.config/systemd/user/mdn.service.d/override.conf <<'EOF'
#   [Service]
#   ExecStart=
#   ExecStart=%h/.local/bin/mdn serve
#   EOF
#   systemctl --user daemon-reload
#
# The empty `ExecStart=` is not a typo and is not optional: it clears the list
# this file set, and without it systemd refuses the unit outright with
# "Service has more than one ExecStart= setting, which is only allowed for
# Type=oneshot services" (measured in debian:stable; with the reset line
# `systemd-analyze --user verify mdn.service` exits 0).

[Unit]
Description=mdn markdown notes daemon

[Service]
ExecStart=/usr/bin/mdn serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
