# systemd user unit for the mdn daemon.
#
# The package installs this file for you, at
# /usr/lib/systemd/user/mdn.service. Installed from source it goes in by hand,
# and `make install` puts the binary where this unit expects it:
#
#   sudo make install
#   install -Dm644 contrib/mdn.service ~/.config/systemd/user/mdn.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now mdn
#
# Either way the daemon runs from /usr/bin/mdn and reads
# ~/.config/mdn/config.yml.
#
# Installed somewhere else — `make install PREFIX=$HOME/.local`, or any other
# prefix — do not edit this file: add a drop-in, which survives the next
# upgrade of the package or the next `git pull`.
#
#   mkdir -p ~/.config/systemd/user/mdn.service.d
#   cat > ~/.config/systemd/user/mdn.service.d/override.conf <<'EOF'
#   [Service]
#   ExecStart=
#   ExecStart=%h/.local/bin/mdn serve
#   EOF
#   systemctl --user daemon-reload
#
# The empty `ExecStart=` is not a typo and is not optional: it clears the list
# this file set, and without it systemd refuses the unit outright with
# "Service has more than one ExecStart= setting, which is only allowed for
# Type=oneshot services" (measured in debian:stable; with the reset line
# `systemd-analyze --user verify mdn.service` exits 0).

[Unit]
Description=mdn markdown notes daemon

[Service]
ExecStart=/usr/bin/mdn serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
